# Telegram Bot Token từ @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram Channel ID hoặc username (@channel_name hoặc -100xxxxxxxxxx)
CHAT_ID=@your_channel_name

# Telegram Private Chat ID (ID cá nhân để test fallback)
PRIVATE_CHAT_ID=your_private_chat_id

# ID deal test thủ công (nếu muốn test 1 bài duy nhất)
TEST_DEAL_ID=38298

# Cấu hình quét tự động Real-time (Hướng 2)
POLL_INTERVAL_SECONDS=15
ENABLE_POST_MONITOR=True
ENABLE_DEAL_MONITOR=True
